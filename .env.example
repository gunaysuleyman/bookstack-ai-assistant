# BookStack Docker Configuration
APP_KEY=base64:MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
DB_PASS=secret_password
DB_PASSWORD=secret_password
DB_NAME=bookstackapp
DB_DATABASE=bookstackapp
DB_USER=bookstack
DB_USERNAME=bookstack

# BookStack API & Webhooks
BOOKSTACK_EXTERNAL_URL=http://localhost:6875
BOOKSTACK_TOKEN_ID=your_bookstack_token_id_here
BOOKSTACK_TOKEN_SECRET=your_bookstack_token_secret_here

# RAG Security Token & Public Endpoint
# Server-side only. Do not put this value in browser JavaScript.
RAG_SECRET_TOKEN=my_super_secret_local_token_123
# BookStack server calls this URL to register a short-lived scope. The browser never sees the secret.
RAG_INTERNAL_URL=http://rag_service:8000
# The public URL the user's browser uses to reach the RAG search endpoint (change to https://wiki.domain.com/api/ai-search in prod)
RAG_SERVICE_PUBLIC_URL=http://localhost:8000/api/ai-search
# Required on the webhook URL as ?token=... because BookStack does not sign webhook bodies.
WEBHOOK_SECRET=change_me_webhook_secret
TOKEN_TTL_SECONDS=900
# off | shadow | on. Default keeps the legacy retrieval path.
ADAPTIVE_RAG=0
ADAPTIVE_INDEXING=0
ENABLE_INDEX_WORKER=1

# AI Provider Configuration ('gemini' or 'openai')
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-3.6-flash

# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Role-Based AI Feature Gating (comma-separated lowercase role names, or 'all')
AI_ALLOWED_ROLES=admin,internal
